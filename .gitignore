# Miscellaneous
*.class
*.log
*.pyc
*.swp
.DS_Store
.atom/
.build/
.buildlog/
.history
.svn/
.swiftpm/
migrate_working_dir/

# IntelliJ related
*.iml
*.ipr
*.iws
.idea/

# The .vscode folder contains launch configuration and tasks you configure in
# VS Code which you may wish to be included in version control, so this line
# is commented out by default.
#.vscode/

# Flutter/Dart/Pub related
**/doc/api/
**/ios/Flutter/.last_build_id
.dart_tool/
.flutter-plugins-dependencies
.pub-cache/
.pub/
/build/
/coverage/

# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release

# Rutas del SDK propias de cada maquina: si se versionan, rompen el build de
# cualquier otro que clone el repo.
/android/local.properties
/android/.gradle/
/android/.kotlin/

# Configuracion local de Claude Code
.claude/

# --- Nada de esto entra al repositorio, nunca --------------------------------
#
# Duplica lo que ya hay en android/.gitignore a proposito: si manana alguien
# toca ese archivo o el keystore aparece en otra carpeta, esta red lo agarra
# igual. Una clave de firma publicada no se puede "despublicar": hay que
# rotarla, y con Play eso significa tramite con Google.

# Claves de firma, en cualquier carpeta y en cualquiera de sus formatos.
*.jks
*.keystore
*.p12
*.pfx
*.pem
*.p8
*.key

# Credenciales de firma de Android. El .example si se versiona: es la plantilla
# sin datos, y el patron de arriba no lo alcanza porque el nombre es exacto.
key.properties
**/key.properties

# Variables de entorno.
.env
.env.*
!.env.example

# Cuentas de servicio de Google (Play Publishing API, Firebase).
google-services.json
GoogleService-Info.plist
service-account*.json
*-service-account.json
